{
  "name": "stasher",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:design": "node scripts/check-css-vars.mjs packages/ui/src apps/web/src apps/desktop/src apps/extension/entrypoints apps/extension/features apps/extension/shared",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
